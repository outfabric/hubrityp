# Postgres connection string consumed by Drizzle (server-only).
# Locally: copy from `npx supabase status` (DB URL) — defaults to
# postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# Public Supabase API URL — printed by `npx supabase status` as "API URL".
# Locally typically http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase anon key — printed by `npx supabase status` as "anon key".
# Safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — printed by `npx supabase status` as
# "service_role key". RLS bypass; server-only; NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Browser-facing Supabase URL. Only needed when the server-side
# NEXT_PUBLIC_SUPABASE_URL is an internal hostname unreachable by the browser
# (e.g. Docker dev where Kong is supabase_kong_hubrityp:8000 internally but
# http://localhost:54321 from the host). Signed Storage URLs are rewritten to
# this origin before reaching the client. Unset in production (the public URL
# is NEXT_PUBLIC_SUPABASE_URL itself).
SUPABASE_PUBLIC_URL=

# Pino log level: debug | info | warn | error | silent.
# Default `info` in production, `debug` in development, `silent` under tests.
LOG_LEVEL=info

# Resend API key for transactional emails (password-changed, account-locked).
# Optional — when absent in dev, the app logs a warning and skips sending.
# Get yours at https://resend.com/api-keys
RESEND_API_KEY=

# Google OAuth credentials for "Sign in with Google".
# Optional in dev — when absent, the Google login button is hidden or disabled.
# See docs/runbooks/google-oauth-setup.md for how to obtain these.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Twilio credentials for WhatsApp messaging (session reminders, confirmations).
# Optional in dev — when absent, WhatsApp features are disabled.
# Get yours at https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# WhatsApp-enabled phone number for sending reminders (e.g., whatsapp:+5511999999999).
# Required for the reminders engine to send messages.
TWILIO_WHATSAPP_FROM=

# Public URL that Twilio calls back for webhook signature (HMAC) validation.
# In dev, use an ngrok/cloudflare tunnel URL pointing to your local server.
TWILIO_WEBHOOK_URL=

# Estimated cost per WhatsApp template message in BRL.
# Used for "Custo estimado" display only — not for billing.
# Update when Twilio changes pricing.
# Default: 0.10
TWILIO_WHATSAPP_TEMPLATE_PRICE_BRL=0.10

# Feature flag that reveals the WhatsApp UI entry points (the "Caixa de entrada"
# menu item and the "WhatsApp" / "Lembretes" settings cards). While the backend
# is incomplete these surfaces are frozen with a "Em breve" tag. Accepts only
# "true" or "false"; defaults to "false" when unset.
# NOTE: because of the NEXT_PUBLIC_ prefix the value is inlined at BUILD time —
# changing it requires a frontend rebuild/redeploy, not just a restart.
# Default: false
NEXT_PUBLIC_WHATSAPP_UI_ENABLED=false

# Stream — video/chat API for telepsychology sessions.
# Get credentials at https://dashboard.getstream.io/
# STREAM_API_KEY and NEXT_PUBLIC_STREAM_API_KEY hold the same value;
# the first is consumed server-side, the second is inlined into the client bundle.
# STREAM_API_SECRET is used server-side to mint user tokens — NEVER expose to the client.
STREAM_API_KEY=
STREAM_API_SECRET=
NEXT_PUBLIC_STREAM_API_KEY=

# Stream webhook secret — used to verify webhook signatures (HMAC) from
# Stream Video call events. Get it at https://dashboard.getstream.io/ under
# your app's webhook configuration. Server-only; NEVER expose to the client.
STREAM_WEBHOOK_SECRET=

# E2E-only escape hatch. When 'true', getStreamClient() returns an in-memory
# no-op stub instead of the real Node SDK, so the seeded Playwright server
# never makes real outbound Stream calls. Defaults to 'false'; production and
# dev MUST leave this unset/false.
E2E_STREAM_STUB=false

# Public-facing application URL (e.g. https://app.hubrityp.com.br).
# Used server-side to build absolute URLs for patient-facing links in
# WhatsApp messages (video call links, etc.). Optional — local dev and CI
# may leave it unset; features that need it degrade gracefully.
APP_URL=

# Inngest — durable execution para lembretes WhatsApp, reconciliacao e webhook handlers.
# Em producao na Vercel: provisionados automaticamente pela integracao
# https://vercel.com/integrations/inngest (NAO preencher manualmente).
# Em dev local: deixar vazio — o SDK detecta ausencia das chaves e usa
# o Dev Server local (inngest service do docker-compose) automaticamente.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Encryption key for @inngest/middleware-encryption. Encrypts all step output
# (clinical transcripts, audio base64, pseudonymized notes) client-side before
# it reaches Inngest Cloud — required for LGPD data-residency compliance.
# Min 32 characters. Generate with: openssl rand -base64 48
# NEVER expose to the client.
INNGEST_ENCRYPTION_KEY=

# Opcional — sobrescreve o origem usado no sync com a cloud Inngest.
# Util apenas quando o dominio publico difere do que a Vercel detecta.
INNGEST_SERVE_ORIGIN=

# Gemini — AI-powered audio transcription and clinical note generation.
# Required: API key obtained from Google AI Studio.
# Get yours at https://aistudio.google.com/apikey
GEMINI_API_KEY=<obtain at https://aistudio.google.com/apikey>

# Gemini model for audio transcription. Must match /^(gemini|gemma)-/.
# Default: gemini-3.5-flash
GEMINI_MODEL_TRANSCRIPTION=gemini-3.5-flash

# Gemini model for clinical note generation from transcripts.
# Must match /^(gemini|gemma)-/. Default: gemini-3.5-flash
GEMINI_MODEL_NOTE=gemini-3.5-flash

# Supabase Storage bucket name for audio files pending transcription.
# Default: ai-transcription-audio
AI_TRANSCRIPTION_BUCKET=ai-transcription-audio

# Hours before uploaded audio files are auto-deleted. Range: 24-168.
# Default: 24
AI_TRANSCRIPTION_AUDIO_TTL_HOURS=24

# Maximum audio file size in MB accepted for transcription. Range: 1-500.
# Default: 200
AI_TRANSCRIPTION_MAX_AUDIO_MB=200

# Server-only salt for hashing IP and user-agent on AI consent signatures.
# Must be at least 32 characters. Generate with: openssl rand -base64 48
# NEVER expose to the client (no NEXT_PUBLIC_ prefix).
SIGNATURE_HASH_SALT=
