# Postgres connection string consumed by Drizzle (server-only).
# Locally: copy from `npx supabase status` (DB URL) — defaults to
# postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# Public Supabase API URL — printed by `npx supabase status` as "API URL".
# Locally typically http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase anon key — printed by `npx supabase status` as "anon key".
# Safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — printed by `npx supabase status` as
# "service_role key". RLS bypass; server-only; NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Browser-facing Supabase URL. Only needed when the server-side
# NEXT_PUBLIC_SUPABASE_URL is an internal hostname unreachable by the browser
# (e.g. Docker dev where Kong is supabase_kong_hubrityp:8000 internally but
# http://localhost:54321 from the host). Signed Storage URLs are rewritten to
# this origin before reaching the client. Unset in production (the public URL
# is NEXT_PUBLIC_SUPABASE_URL itself).
SUPABASE_PUBLIC_URL=

# Pino log level: debug | info | warn | error | silent.
# Default `info` in production, `debug` in development, `silent` under tests.
LOG_LEVEL=info

# Resend API key for transactional emails (password-changed, account-locked).
# Optional — when absent in dev, the app logs a warning and skips sending.
# Get yours at https://resend.com/api-keys
RESEND_API_KEY=

# Google OAuth credentials for "Sign in with Google".
# Optional in dev — when absent, the Google login button is hidden or disabled.
# See docs/runbooks/google-oauth-setup.md for how to obtain these.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Twilio credentials for WhatsApp messaging (session reminders, confirmations).
# Optional in dev — when absent, WhatsApp features are disabled.
# Get yours at https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# WhatsApp-enabled phone number for sending reminders (e.g., whatsapp:+5511999999999).
# Required for the reminders engine to send messages.
TWILIO_WHATSAPP_FROM=

# Public URL that Twilio calls back for webhook signature (HMAC) validation.
# In dev, use an ngrok/cloudflare tunnel URL pointing to your local server.
TWILIO_WEBHOOK_URL=

# Estimated cost per WhatsApp template message in BRL.
# Used for "Custo estimado" display only — not for billing.
# Update when Twilio changes pricing.
# Default: 0.10
TWILIO_WHATSAPP_TEMPLATE_PRICE_BRL=0.10

# Inngest — durable execution para lembretes WhatsApp, reconciliacao e webhook handlers.
# Em producao na Vercel: provisionados automaticamente pela integracao
# https://vercel.com/integrations/inngest (NAO preencher manualmente).
# Em dev local: deixar vazio — o SDK detecta ausencia das chaves e usa
# o Dev Server local (inngest service do docker-compose) automaticamente.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Opcional — sobrescreve o origem usado no sync com a cloud Inngest.
# Util apenas quando o dominio publico difere do que a Vercel detecta.
INNGEST_SERVE_ORIGIN=
